  return`
  <div class="page-header">
    <div><h2>Informes</h2><p>Reportes financieros por período</p></div>
    <select class="form-control" style="width:auto" id="reportMonth" onchange="setState({reportMonth:this.value})">
      ${months.map(m=>`<option value="${m}" ${m===selMonth?'selected':''}>${m}</option>`).join('')}
    </select>
  </div>
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><span class="card-title">Ingresos — ${selMonth}</span></div>
      <div style="font-size:13px;color:#6b7280;margin-bottom:12px">${mp.length} pagos · <b class="green">${fmt(totalIn)}</b></div>
      <table><thead><tr><th>Depto</th><th>Residente</th><th>Monto</th><th>Método</th></tr></thead>
      <tbody>${mp.map(p=>`<tr>
        <td><b>${DEPTS.find(d=>d.id===p.deptId)?.number||'—'}</b></td>
        <td>${state.residents.find(r=>r.id===p.residentId)?.name||'—'}</td>
        <td class="green" style="font-weight:700">${fmt(p.amount)}</td>
        <td>${p.method}</td>
      </tr>`).join('')}</tbody></table>
      <div style="margin-top:12px"><button class="btn btn-sm btn-primary" onclick="printReport('ingresos','${selMonth}')">⬇ Imprimir informe</button></div>
    </div>
    <div class="card">
      <div class="card-header"><span class="card-title">Gastos — ${selMonth}</span></div>
      <div style="font-size:13px;color:#6b7280;margin-bottom:12px">${me.length} gastos · <b class="red">${fmt(totalOut)}</b></div>
      <table><thead><tr><th>Categoría</th><th>Descripción</th><th>Monto</th></tr></thead>
      <tbody>${me.map(e=>`<tr>
        <td><span class="badge badge-blue">${e.category}</span></td>
        <td>${e.description||'—'}</td>
        <td class="red" style="font-weight:700">${fmt(e.amount)}</td>
      </tr>`).join('')}</tbody></table>
      <div style="margin-top:12px"><button class="btn btn-sm btn-primary" onclick="printReport('gastos','${selMonth}')">⬇ Imprimir informe</button></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">Balance general — ${selMonth}</span></div>
    <div class="stat-row"><span>Total ingresos</span><span class="green" style="font-weight:700">${fmt(totalIn)}</span></div>
    <div class="stat-row"><span>Total gastos</span><span class="red" style="font-weight:700">${fmt(totalOut)}</span></div>
    <div class="stat-row"><span>Departamentos morosos</span><span><span class="badge badge-red">${morose.length}</span></span></div>
    <div class="stat-row" style="font-size:16px;font-weight:700"><span>Saldo neto</span><span class="${balance>=0?'green':'red'}">${fmt(balance)}</span></div>
    <div style="margin-top:14px;display:flex;gap:8px">
      <button class="btn btn-primary" onclick="printReport('balance','${selMonth}')">⬇ Imprimir balance</button>
      <button class="btn" onclick="printReport('morosos','${selMonth}')">⬇ Informe morosos</button>
    </div>
  </div>`;
}

