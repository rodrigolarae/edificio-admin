      <td><span class="badge badge-blue">${e.category}</span></td>
      <td>${e.description||'—'}</td>
      <td>${e.month}</td>
      <td>${fmtD(e.date)}</td>
      <td style="font-weight:700;color:#dc2626">${fmt(e.amount)}</td>
    </tr>`).join('')}</tbody></table>
  </div>`;
}

function buildBank(){
  const{payments,expenses}=state;
  const allMovs=[...payments.map(p=>({...p,_t:'crédito',_desc:`Pago GC Depto ${DEPTS.find(d=>d.id===p.deptId)?.number||''}`})),...expenses.map(e=>({...e,_t:'débito',_desc:e.description||e.category}))].sort((a,b)=>new Date(b.date)-new Date(a.date));
  const totalIn=payments.reduce((s,p)=>s+p.amount,0);
  const totalOut=expenses.reduce((s,e)=>s+e.amount,0);
  let saldo=totalIn-totalOut;
  const movs=allMovs.map(m=>{const s=saldo;saldo+=m._t==='débito'?m.amount:-m.amount;return{...m,saldo:s}});
  return`
  <div class="page-header"><div><h2>Cuenta Corriente</h2><p>Registro de movimientos del edificio</p></div><span class="badge badge-amber" style="font-size:12px;padding:6px 12px">Simulación — listo para integrar banco</span></div>
  <div class="metrics" style="grid-template-columns:repeat(3,1fr)">
    <div class="metric"><div class="metric-label">Total créditos</div><div class="metric-value green">${fmt(totalIn)}</div></div>
    <div class="metric"><div class="metric-label">Total débitos</div><div class="metric-value red">${fmt(totalOut)}</div></div>
    <div class="metric"><div class="metric-label">Saldo disponible</div><div class="metric-value ${totalIn-totalOut>=0?'green':'red'}">${fmt(totalIn-totalOut)}</div></div>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">Cartola de movimientos</span></div>
    <table><thead><tr><th>Fecha</th><th>Descripción</th><th>Tipo</th><th>Monto</th><th>Saldo</th></tr></thead>
    <tbody>${movs.map(m=>`<tr>
      <td>${fmtD(m.date)}</td>
      <td>${m._desc}</td>
      <td><span class="badge ${m._t==='crédito'?'badge-green':'badge-red'}">${m._t}</span></td>
      <td style="font-weight:700;color:${m._t==='crédito'?'#059669':'#dc2626'}">${m._t==='crédito'?'+':'-'}${fmt(m.amount)}</td>
      <td style="font-weight:600">${fmt(m.saldo)}</td>
    </tr>`).join('')}</tbody></table>
  </div>`;
}

