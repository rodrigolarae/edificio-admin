      <div class="metric"><div class="metric-label">Gasto común mensual</div><div class="metric-value blue">${fmt(dept?.monthlyFee||85000)}</div></div>
      <div class="metric"><div class="metric-label">Deuda actual</div><div class="metric-value ${debt>0?'red':'green'}">${fmt(debt)}</div></div>
