// ---- EVENTOS ----
function attachEvents(){
  document.getElementById('modeSelect')?.addEventListener('change',function(){
    const v=this.value;
    if(v==='admin'){setState({mode:'admin',view:'dashboard'})}
    else{const rid=v.replace('res_','');setState({mode:v,view:'my_account',currentResident:INIT_RESIDENTS.find(r=>r.id===rid)||INIT_RESIDENTS[0]})}
  });
  document.querySelectorAll('[data-view]').forEach(btn=>{
    btn.addEventListener('click',()=>setState({view:btn.dataset.view}));
  });
  document.getElementById('btnAddResident')?.addEventListener('click',()=>{
    const f=document.getElementById('residentForm');
    f.style.display=f.style.display==='none'?'block':'none';
  });
  document.getElementById('btnCancelResident')?.addEventListener('click',()=>{
    document.getElementById('residentForm').style.display='none';
  });
  document.getElementById('btnSaveResident')?.addEventListener('click',()=>{
    const name=document.getElementById('rName').value.trim();
    const email=document.getElementById('rEmail').value.trim();
    const deptId=document.getElementById('rDept').value;
    if(!name||!email||!deptId){showAlert('Completa los campos obligatorios (*)','error');return;}
    addResident({name,email,rut:document.getElementById('rRut').value,phone:document.getElementById('rPhone').value,deptId});
  });
  document.getElementById('btnAddPayment')?.addEventListener('click',()=>{
    const f=document.getElementById('paymentForm');
    f.style.display=f.style.display==='none'?'block':'none';
  });
  document.getElementById('btnCancelPayment')?.addEventListener('click',()=>{
    document.getElementById('paymentForm').style.display='none';
  });
  document.getElementById('btnSavePayment')?.addEventListener('click',()=>{
    const residentId=document.getElementById('pResident').value;
    const amount=document.getElementById('pAmount').value;
    const date=document.getElementById('pDate').value;
    const method=document.getElementById('pMethod').value;
    if(!residentId||!amount||!date){showAlert('Completa los campos obligatorios','error');return;}
    const r=state.residents.find(x=>x.id===residentId);
    addPayment({residentId,deptId:r?.deptId,amount,date,method});
  });
  document.getElementById('btnAddExpense')?.addEventListener('click',()=>{
    const f=document.getElementById('expenseForm');
    f.style.display=f.style.display==='none'?'block':'none';
  });
  document.getElementById('btnCancelExpense')?.addEventListener('click',()=>{
    document.getElementById('expenseForm').style.display='none';
  });
  document.getElementById('btnSaveExpense')?.addEventListener('click',()=>{
    const amount=document.getElementById('eAmount').value;
    const date=document.getElementById('eDate').value;
    if(!amount||!date){showAlert('Completa los campos obligatorios','error');return;}
    addExpense({category:document.getElementById('eCategory').value,amount,date,description:document.getElementById('eDesc').value});
  });
  document.getElementById('modalOverlay')?.addEventListener('click',function(e){
    if(e.target===this)setState({modal:null});
  });
}

window.onResidentChange=function(sel){
  const r=state.residents.find(x=>x.id===sel.value);
  const d=r?DEPTS.find(d=>d.id===r.deptId):null;
  const inp=document.getElementById('pDept');
  if(inp)inp.value=d?`Depto ${d.number} — Piso ${d.floor}`:'—';
};

window.viewReceipt=function(paymentId){
  const p=state.payments.find(x=>x.id===paymentId);
  if(!p)return;
  setState({modal:{type:'receipt',payment:p,resident:state.residents.find(r=>r.id===p.residentId),dept:DEPTS.find(d=>d.id===p.deptId)}});
};

window.printReport=function(type,month){
  window.print();
};

window.setState=setState;

render();
</script>
