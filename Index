  <div class="card">
    <div class="card-header"><span class="card-title">Historial de pagos</span><span style="font-size:13px;color:#059669;font-weight:700">Total pagado: ${fmt(totalPaid)}</span></div>
    ${myPayments.length===0?'<div class="empty">Sin pagos registrados</div>':
    `<table><thead><tr><th>Mes</th><th>Monto</th><th>Método</th><th>Fecha</th><th>Comprobante</th></tr></thead>
