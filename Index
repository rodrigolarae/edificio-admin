<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EdificioAdmin</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f0f2f5;color:#1a1a1a;min-height:100vh}
.app{display:flex;height:100vh;overflow:hidden}
.sidebar{width:220px;background:#fff;border-right:1px solid #e5e5e5;display:flex;flex-direction:column;flex-shrink:0}
.logo{padding:20px 16px 16px;border-bottom:1px solid #e5e5e5;background:#1a56db}
.logo h1{font-size:16px;font-weight:700;color:#fff}
.logo p{font-size:11px;color:#bfdbfe;margin-top:2px}
.mode-switch{padding:10px;border-bottom:1px solid #e5e5e5}
.mode-switch select{width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;background:#fff}
.nav{flex:1;padding:8px 0;overflow-y:auto}
.nav-section{padding:12px 16px 4px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#9ca3af}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 16px;font-size:13px;color:#374151;cursor:pointer;border:none;background:none;width:100%;text-align:left;transition:all .15s}
.nav-item:hover{background:#f3f4f6;color:#1a1a1a}
.nav-item.active{background:#eff6ff;color:#1a56db;font-weight:600;border-right:3px solid #1a56db}
.user-info{padding:12px 16px;border-top:1px solid #e5e5e5;font-size:12px;color:#6b7280}
.role-badge{display:inline-block;padding:2px 8px;border-radius:12px;font-size:10px;font-weight:600;margin-top:4px}
.role-admin{background:#dbeafe;color:#1e40af}
.role-resident{background:#d1fae5;color:#065f46}
.main{flex:1;overflow-y:auto;padding:24px;background:#f0f2f5}
.page-header{margin-bottom:20px;display:flex;justify-content:space-between;align-items:flex-start}
.page-header h2{font-size:20px;font-weight:700}
.page-header p{font-size:13px;color:#6b7280;margin-top:2px}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.metric{background:#fff;border-radius:10px;padding:16px;border:1px solid #e5e5e5}
.metric-label{font-size:11px;color:#6b7280;margin-bottom:6px;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.metric-value{font-size:22px;font-weight:700}
.green{color:#059669}.red{color:#dc2626}.blue{color:#1a56db}.amber{color:#d97706}
.card{background:#fff;border:1px solid #e5e5e5;border-radius:10px;padding:18px 20px;margin-bottom:16px}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.card-title{font-size:14px;font-weight:700;color:#111}
.btn{padding:8px 16px;border-radius:8px;border:1px solid #d1d5db;background:#fff;font-size:13px;cursor:pointer;font-family:inherit;transition:all .15s;color:#374151;font-weight:500}
.btn:hover{background:#f9fafb;border-color:#9ca3af}
.btn-primary{background:#1a56db;color:#fff;border-color:#1a56db}
.btn-primary:hover{background:#1e40af}
.btn-sm{padding:5px 10px;font-size:12px}
.btn-success{background:#059669;color:#fff;border-color:#059669}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:9px 12px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:#6b7280;border-bottom:1px solid #e5e5e5;background:#f9fafb}
td{padding:11px 12px;border-bottom:1px solid #f3f4f6;color:#374151}
tr:hover td{background:#fafafa}
tr:last-child td{border-bottom:none}
.badge{display:inline-block;padding:3px 9px;border-radius:12px;font-size:11px;font-weight:600}
.badge-green{background:#d1fae5;color:#065f46}
.badge-red{background:#fee2e2;color:#991b1b}
.badge-amber{background:#fef3c7;color:#92400e}
.badge-blue{background:#dbeafe;color:#1e40af}
.badge-gray{background:#f3f4f6;color:#374151}
.form-group{margin-bottom:14px}
.form-label{display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:5px}
.form-control{width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:13px;font-family:inherit;background:#fff;color:#111;transition:border .15s}
.form-control:focus{outline:none;border-color:#1a56db;box-shadow:0 0 0 3px rgba(26,86,219,.1)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:1000;padding:16px}
.modal{background:#fff;border-radius:12px;padding:24px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto}
.modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.modal-title{font-size:16px;font-weight:700}
.close-btn{background:none;border:none;font-size:22px;cursor:pointer;color:#6b7280;line-height:1}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.avatar{width:34px;height:34px;border-radius:50%;background:#dbeafe;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#1e40af;flex-shrink:0}
.empty{text-align:center;padding:40px;color:#9ca3af;font-size:14px}
.alert{padding:12px 16px;border-radius:8px;font-size:13px;margin-bottom:16px;font-weight:500}
.alert-success{background:#d1fae5;color:#065f46;border:1px solid #a7f3d0}
.alert-error{background:#fee2e2;color:#991b1b;border:1px solid #fca5a5}
.receipt{background:#fff;border:1px solid #e5e5e5;border-radius:10px;padding:28px;font-size:13px}
.receipt-header{text-align:center;padding-bottom:20px;margin-bottom:20px;border-bottom:2px dashed #e5e5e5}
.receipt-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #f3f4f6}
.receipt-total{font-size:17px;font-weight:700;margin-top:12px;padding-top:12px;border-top:2px solid #e5e5e5;display:flex;justify-content:space-between}
.progress-bar{height:8px;background:#f3f4f6;border-radius:4px;overflow:hidden;margin-top:6px}
.progress-fill{height:100%;border-radius:4px;transition:width .4s}
.stat-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f3f4f6;font-size:13px}
.stat-row:last-child{border-bottom:none}
@media(max-width:768px){.metrics{grid-template-columns:1fr 1fr}.grid-2{grid-template-columns:1fr}.sidebar{display:none}}
</style>
</head>
<body>
<div id="app"></div>
<script>
const DEPTS=Array.from({length:36},(_,i)=>({id:i+1,number:`${Math.floor(i/4)+1}0${(i%4)+1}`,floor:Math.floor(i/4)+1,monthlyFee:85000}));
const CATS=['Agua','Electricidad','Gas','Mantención','Limpieza','Administración','Seguros','Otros'];
const fmt=n=>new Intl.NumberFormat('es-CL',{style:'currency',currency:'CLP',maximumFractionDigits:0}).format(n);
const fmtD=d=>new Date(d).toLocaleDateString('es-CL');
const uid=()=>Math.random().toString(36).substr(2,9).toUpperCase();
const today=()=>new Date().toISOString().split('T')[0];
const thisMonth=()=>{const d=new Date();return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`};
const save=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}};
const load=(k,def)=>{try{const v=localStorage.getItem(k);return v?JSON.parse(v):def}catch(e){return def}};

const INIT_RESIDENTS=[
  {id:'r1',name:'María González',email:'maria@email.com',phone:'912345678',deptId:1,rut:'12.345.678-9'},
  {id:'r2',name:'Juan Pérez',email:'juan@email.com',phone:'923456789',deptId:2,rut:'13.456.789-0'},
  {id:'r3',name:'Ana Rodríguez',email:'ana@email.com',phone:'934567890',deptId:5,rut:'14.567.890-1'},
  {id:'r4',name:'Carlos López',email:'carlos@email.com',phone:'945678901',deptId:9,rut:'15.678.901-2'},
  {id:'r5',name:'Sofía Martínez',email:'sofia@email.com',phone:'956789012',deptId:13,rut:'16.789.012-3'},
];
const INIT_PAYMENTS=[
  {id:uid(),deptId:1,residentId:'r1',amount:85000,date:'2025-06-05',method:'Transferencia',month:'2025-06',receiptId:uid()},
  {id:uid(),deptId:2,residentId:'r2',amount:85000,date:'2025-06-03',method:'Transferencia',month:'2025-06',receiptId:uid()},
  {id:uid(),deptId:5,residentId:'r3',amount:85000,date:'2025-05-28',method:'Efectivo',month:'2025-05',receiptId:uid()},
  {id:uid(),deptId:9,residentId:'r4',amount:85000,date:'2025-06-08',method:'Débito',month:'2025-06',receiptId:uid()},
];
const INIT_EXPENSES=[
  {id:uid(),category:'Agua',amount:180000,date:'2025-06-01',description:'Cuenta agua junio',month:'2025-06'},
  {id:uid(),category:'Electricidad',amount:95000,date:'2025-06-01',description:'Luz áreas comunes',month:'2025-06'},
  {id:uid(),category:'Mantención',amount:120000,date:'2025-06-10',description:'Reparación ascensor',month:'2025-06'},
  {id:uid(),category:'Limpieza',amount:80000,date:'2025-06-05',description:'Servicio limpieza',month:'2025-06'},
];

let state={
  view:'dashboard',
  mode:'admin',
  residents:load('ea_residents',INIT_RESIDENTS),
  payments:load('ea_payments',INIT_PAYMENTS),
  expenses:load('ea_expenses',INIT_EXPENSES),
  modal:null,
  alert:null,
  alertTimer:null,
  currentResident:INIT_RESIDENTS[0],
};

function setState(partial){
  state={...state,...partial};
  render();
}

function showAlert(msg,type='success'){
  if(state.alertTimer)clearTimeout(state.alertTimer);
  const t=setTimeout(()=>setState({alert:null,alertTimer:null}),3500);
  setState({alert:{msg,type},alertTimer:t});
}

function saveAll(){
  save('ea_residents',state.residents);
  save('ea_payments',state.payments);
  save('ea_expenses',state.expenses);
}

// ---- LÓGICA ----
function addPayment(data){
  const p={...data,id:uid(),receiptId:uid(),month:data.date.substr(0,7),amount:parseInt(data.amount),deptId:parseInt(data.deptId)};
  const payments=[p,...state.payments];
  save('ea_payments',payments);
  setState({payments,modal:{type:'receipt',payment:p,resident:state.residents.find(r=>r.id===p.residentId),dept:DEPTS.find(d=>d.id===p.deptId)}});
}
function addExpense(data){
  const e={...data,id:uid(),month:data.date.substr(0,7),amount:parseInt(data.amount)};
  const expenses=[e,...state.expenses];
  save('ea_expenses',expenses);
  setState({expenses});
  showAlert('Gasto registrado correctamente');
}
function addResident(data){
  const r={...data,id:'r'+uid(),deptId:parseInt(data.deptId)};
  const residents=[...state.residents,r];
  save('ea_residents',residents);
  setState({residents});
  showAlert('Residente registrado exitosamente');
}

// ---- RENDER ----
function render(){
  document.getElementById('app').innerHTML=buildApp();
  attachEvents();
}

function buildApp(){
  const{view,mode,alert}=state;
  const isAdmin=mode==='admin';
  const navAdmin=[
    {id:'dashboard',icon:'⊞',label:'Dashboard'},
    {id:'residents',icon:'👤',label:'Residentes'},
    {id:'payments',icon:'💰',label:'Ingresos'},
    {id:'expenses',icon:'📉',label:'Gastos'},
    {id:'bank',icon:'🏦',label:'Cuenta Corriente'},
    {id:'reports',icon:'📄',label:'Informes'},
  ];
  const navResident=[
    {id:'my_account',icon:'👤',label:'Mi Cuenta'},
    {id:'my_payments',icon:'📋',label:'Mis Pagos'},
  ];
  const nav=isAdmin?navAdmin:navResident;

  return`<div class="app">
  <aside class="sidebar">
    <div class="logo">
      <h1>🏢 EdificioAdmin</h1>
      <p>36 Unidades · Sistema de Gestión</p>
    </div>
    <div class="mode-switch">
      <select id="modeSelect">
        <option value="admin" ${mode==='admin'?'selected':''}>👔 Administrador</option>
        ${INIT_RESIDENTS.map(r=>`<option value="res_${r.id}" ${mode==='res_'+r.id?'selected':''}>${r.name.split(' ')[0]} (Residente)</option>`).join('')}
      </select>
    </div>
    <nav class="nav">
      <div class="nav-section">${isAdmin?'Administración':'Mi Portal'}</div>
      ${nav.map(n=>`<button class="nav-item${view===n.id?' active':''}" data-view="${n.id}">${n.icon} ${n.label}</button>`).join('')}
    </nav>
    <div class="user-info">
      <div>${isAdmin?'Administrador del Edificio':state.currentResident?.name||''}</div>
      <span class="role-badge ${isAdmin?'role-admin':'role-resident'}">${isAdmin?'Admin':'Residente'}</span>
    </div>
  </aside>
  <main class="main">
    ${alert?`<div class="alert alert-${alert.type}">${alert.msg}</div>`:''}
    ${buildView()}
    ${state.modal?buildModal():''}
  </main>
</div>`;
}

function buildView(){
  const v=state.view;
  if(v==='dashboard')return buildDashboard();
  if(v==='residents')return buildResidents();
  if(v==='payments')return buildPayments();
  if(v==='expenses')return buildExpenses();
  if(v==='bank')return buildBank();
  if(v==='reports')return buildReports();
  if(v==='my_account')return buildMyAccount();
  if(v==='my_payments')return buildMyPayments();
  return'';
}

function getMetrics(month){
  const mp=state.payments.filter(p=>p.month===month);
  const me=state.expenses.filter(e=>e.month===month);
  const totalIn=mp.reduce((s,p)=>s+p.amount,0);
  const totalOut=me.reduce((s,e)=>s+e.amount,0);
  const paidDepts=new Set(mp.map(p=>p.deptId));
  const occupied=DEPTS.filter(d=>state.residents.some(r=>r.deptId===d.id));
  const morose=occupied.filter(d=>!paidDepts.has(d.id));
  return{totalIn,totalOut,balance:totalIn-totalOut,paidDepts,occupied,morose,mp,me};
}

function buildDashboard(){
  const m=thisMonth();
  const{totalIn,totalOut,balance,paidDepts,occupied,morose,mp,me}=getMetrics(m);
  const recents=[...state.payments.map(p=>({...p,_t:'ingreso'})),...state.expenses.map(e=>({...e,_t:'gasto'}))].sort((a,b)=>new Date(b.date)-new Date(a.date)).slice(0,7);
  const pct=Math.round(paidDepts.size/Math.max(occupied.length,1)*100);
  return`
  <div class="page-header"><div><h2>Dashboard</h2><p>${new Date().toLocaleDateString('es-CL',{weekday:'long',year:'numeric',month:'long',day:'numeric'})}</p></div></div>
  <div class="metrics">
    <div class="metric"><div class="metric-label">Ingresos del mes</div><div class="metric-value green">${fmt(totalIn)}</div></div>
    <div class="metric"><div class="metric-label">Gastos del mes</div><div class="metric-value red">${fmt(totalOut)}</div></div>
    <div class="metric"><div class="metric-label">Saldo neto</div><div class="metric-value ${balance>=0?'green':'red'}">${fmt(balance)}</div></div>
    <div class="metric"><div class="metric-label">Deptos morosos</div><div class="metric-value amber">${morose.length} / ${occupied.length}</div></div>
  </div>
  <div class="grid-2">
    <div class="card">
      <div class="card-header"><span class="card-title">Estado de cobros — ${m}</span></div>
      <div style="font-size:13px;color:#6b7280;margin-bottom:8px">${paidDepts.size} pagados · ${morose.length} pendientes de ${occupied.length} ocupados</div>
      <div class="progress-bar"><div class="progress-fill" style="width:${pct}%;background:#059669"></div></div>
      <div style="font-size:12px;color:#6b7280;margin-top:6px">${pct}% cobrado este mes</div>
      ${morose.length>0?`<div style="margin-top:12px;font-size:12px;color:#dc2626;font-weight:600">Morosos: ${morose.map(d=>`Depto ${d.number}`).join(', ')}</div>`:''}
    </div>
    <div class="card">
      <div class="card-header"><span class="card-title">Balance del mes</span></div>
      <div class="stat-row"><span>Total ingresos</span><span class="green" style="font-weight:700">${fmt(totalIn)}</span></div>
      <div class="stat-row"><span>Total gastos</span><span class="red" style="font-weight:700">${fmt(totalOut)}</span></div>
      <div class="stat-row" style="font-size:15px;font-weight:700"><span>Saldo neto</span><span class="${balance>=0?'green':'red'}">${fmt(balance)}</span></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">Últimos movimientos</span></div>
    <table><thead><tr><th>Tipo</th><th>Descripción</th><th>Fecha</th><th>Monto</th></tr></thead>
    <tbody>${recents.map(r=>`<tr>
      <td><span class="badge ${r._t==='ingreso'?'badge-green':'badge-red'}">${r._t}</span></td>
      <td>${r._t==='ingreso'?`Depto ${DEPTS.find(d=>d.id===r.deptId)?.number||''} · ${state.residents.find(x=>x.id===r.residentId)?.name||''}`:r.description||r.category}</td>
      <td>${fmtD(r.date)}</td>
      <td style="font-weight:700;color:${r._t==='ingreso'?'#059669':'#dc2626'}">${r._t==='ingreso'?'+':'-'}${fmt(r.amount)}</td>
    </tr>`).join('')}</tbody></table>
  </div>`;
}

function buildResidents(){
  const{residents}=state;
  const curM=thisMonth();
  const availDepts=DEPTS.filter(d=>!residents.some(r=>r.deptId===d.id));
  return`
  <div class="page-header">
    <div><h2>Residentes</h2><p>${residents.length} residentes · ${DEPTS.length-residents.length} unidades disponibles</p></div>
    <button class="btn btn-primary" id="btnAddResident">+ Nuevo residente</button>
  </div>
  <div id="residentForm" style="display:none" class="card">
    <div class="card-title" style="margin-bottom:16px">Registrar nuevo residente</div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Nombre completo *</label><input class="form-control" id="rName" placeholder="Ej: María González"></div>
      <div class="form-group"><label class="form-label">RUT</label><input class="form-control" id="rRut" placeholder="12.345.678-9"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Email *</label><input class="form-control" id="rEmail" type="email" placeholder="correo@email.com"></div>
      <div class="form-group"><label class="form-label">Teléfono</label><input class="form-control" id="rPhone" placeholder="9XXXXXXXX"></div>
    </div>
    <div class="form-group"><label class="form-label">Departamento *</label>
      <select class="form-control" id="rDept">
        <option value="">Seleccionar departamento...</option>
        ${availDepts.map(d=>`<option value="${d.id}">Depto ${d.number} — Piso ${d.floor}</option>`).join('')}
      </select>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-primary" id="btnSaveResident">Registrar residente</button>
      <button class="btn" id="btnCancelResident">Cancelar</button>
    </div>
  </div>
  <div class="card">
    <table><thead><tr><th>Residente</th><th>Departamento</th><th>Contacto</th><th>Estado mes actual</th></tr></thead>
    <tbody>${residents.map(r=>{
      const d=DEPTS.find(x=>x.id===r.deptId);
      const paid=state.payments.some(p=>p.residentId===r.id&&p.month===curM);
      return`<tr>
        <td><div style="display:flex;align-items:center;gap:10px"><div class="avatar">${r.name.charAt(0)}</div><div><div style="font-weight:600">${r.name}</div><div style="font-size:11px;color:#6b7280">${r.rut||'Sin RUT'}</div></div></div></td>
        <td>${d?`<b>Depto ${d.number}</b> · Piso ${d.floor}`:'—'}</td>
        <td><div style="font-size:12px"><div>${r.email}</div><div style="color:#6b7280">${r.phone||'—'}</div></div></td>
        <td><span class="badge ${paid?'badge-green':'badge-red'}">${paid?'✓ Al día':'⚠ Moroso'}</span></td>
      </tr>`;
    }).join('')}</tbody></table>
  </div>`;
}

function buildPayments(){
  const{payments,residents}=state;
  return`
  <div class="page-header">
    <div><h2>Ingresos — Gastos Comunes</h2><p>${payments.length} pagos registrados en total</p></div>
    <button class="btn btn-primary" id="btnAddPayment">+ Registrar pago</button>
  </div>
  <div id="paymentForm" style="display:none" class="card">
    <div class="card-title" style="margin-bottom:16px">Registrar nuevo pago</div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Residente *</label>
        <select class="form-control" id="pResident" onchange="onResidentChange(this)">
          <option value="">Seleccionar residente...</option>
          ${residents.map(r=>`<option value="${r.id}">${r.name}</option>`).join('')}
        </select>
      </div>
      <div class="form-group"><label class="form-label">Departamento</label><input class="form-control" id="pDept" readonly placeholder="Se completa automático"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Monto ($) *</label><input class="form-control" id="pAmount" type="number" value="85000"></div>
      <div class="form-group"><label class="form-label">Fecha *</label><input class="form-control" id="pDate" type="date" value="${today()}"></div>
    </div>
    <div class="form-group"><label class="form-label">Método de pago</label>
      <select class="form-control" id="pMethod">
        ${['Transferencia','Efectivo','Débito','Crédito','Cheque'].map(m=>`<option>${m}</option>`).join('')}
      </select>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-success" id="btnSavePayment">✓ Registrar y generar comprobante</button>
