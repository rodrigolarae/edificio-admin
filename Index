  return`
  <div class="page-header">
    <div><h2>Gastos del Edificio</h2><p>${expenses.length} gastos registrados</p></div>
    <button class="btn btn-primary" id="btnAddExpense">+ Registrar gasto</button>
  </div>
  <div id="expenseForm" style="display:none" class="card">
    <div class="card-title" style="margin-bottom:16px">Registrar nuevo gasto</div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Categoría *</label>
        <select class="form-control" id="eCategory">${CATS.map(c=>`<option>${c}</option>`).join('')}</select>
      </div>
      <div class="form-group"><label class="form-label">Monto ($) *</label><input class="form-control" id="eAmount" type="number" placeholder="0"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Fecha *</label><input class="form-control" id="eDate" type="date" value="${today()}"></div>
      <div class="form-group"><label class="form-label">Descripción</label><input class="form-control" id="eDesc" placeholder="Descripción del gasto"></div>
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-primary" id="btnSaveExpense">Registrar gasto</button>
      <button class="btn" id="btnCancelExpense">Cancelar</button>
    </div>
  </div>
  ${byCat.length>0?`<div class="card">
    <div class="card-header"><span class="card-title">Gastos por categoría</span></div>
    ${byCat.sort((a,b)=>b.total-a.total).map(({cat,total})=>`
    <div style="margin-bottom:12px">
      <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px"><span>${cat}</span><span style="font-weight:700">${fmt(total)}</span></div>
      <div class="progress-bar"><div class="progress-fill" style="width:${Math.round(total/maxVal*100)}%;background:#1a56db"></div></div>
    </div>`).join('')}
  </div>`:''}
  <div class="card">
    <table><thead><tr><th>Categoría</th><th>Descripción</th><th>Mes</th><th>Fecha</th><th>Monto</th></tr></thead>
