  const debt=paid?0:dept?.monthlyFee||85000;
  const totalPaid=myPayments.reduce((s,p)=>s+p.amount,0);
  return`
  <div class="page-header"><h2>Mi Cuenta</h2></div>
  <div class="card">
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
      <div class="avatar" style="width:56px;height:56px;font-size:20px">${r?.name?.charAt(0)||'?'}</div>
      <div>
        <h3 style="font-size:18px;font-weight:700">${r?.name||'—'}</h3>
        <p style="color:#6b7280;font-size:13px">Depto ${dept?.number||'—'} · Piso ${dept?.floor||'—'}</p>
