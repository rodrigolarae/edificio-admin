-- 1. HABILITAR RLS EN TODAS LAS TABLAS EXISTENTES
DO $$
DECLARE
  t text;
BEGIN
  FOR t IN 
    SELECT tablename FROM pg_tables 
    WHERE schemaname = 'public' 
    AND tablename NOT IN ('schema_migrations', 'schema_migrations_history')
  LOOP
    EXECUTE format('ALTER TABLE IF EXISTS %I ENABLE ROW LEVEL SECURITY', t);
  END LOOP;
END $$;

-- 2. TABLA DE PERFILES (vinculada a auth.users)
CREATE TABLE IF NOT EXISTS perfiles (
  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,
  nombre TEXT NOT NULL,
  comunidad_id UUID REFERENCES comunidades(id),
  unidad_id UUID REFERENCES unidades(id),
  rol TEXT NOT NULL CHECK (rol IN ('residente','admin','presidente','tesorero','conserje','superadmin')),
  activo BOOLEAN DEFAULT true,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT now(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT now()
);

ALTER TABLE perfiles ENABLE ROW LEVEL SECURITY;

-- Política: un usuario ve su propio perfil y los de su comunidad (si es admin+)
CREATE POLICY "perfiles_select" ON perfiles
FOR SELECT TO authenticated
USING (
  id = auth.uid()
  OR comunidad_id IN (
    SELECT comunidad_id FROM perfiles 
    WHERE id = auth.uid() AND rol IN ('admin','presidente','tesorero','conserje','superadmin')
  )
);

CREATE POLICY "perfiles_insert" ON perfiles
FOR INSERT TO authenticated
WITH CHECK (id = auth.uid());

CREATE POLICY "perfiles_update" ON perfiles
FOR UPDATE TO authenticated
USING (
  id = auth.uid()
  OR comunidad_id IN (
    SELECT comunidad_id FROM perfiles WHERE id = auth.uid() AND rol IN ('admin','superadmin')
  )
);

-- 3. TABLA PAGOS_FLOW (para trazabilidad de pagos digitales)
CREATE TABLE IF NOT EXISTS pagos_flow (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  usuario_id UUID REFERENCES auth.users(id),
  comunidad_id UUID REFERENCES comunidades(id),
  unidad_id UUID REFERENCES unidades(id),
  flow_token TEXT,
  flow_url TEXT,
  amount INTEGER NOT NULL,
  status TEXT DEFAULT 'pendiente' CHECK (status IN ('pendiente','pagado','rechazado','anulado')),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT now(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT now()
);

ALTER TABLE pagos_flow ENABLE ROW LEVEL SECURITY;

CREATE POLICY "pagos_flow_select" ON pagos_flow
FOR SELECT TO authenticated
USING (
  usuario_id = auth.uid()
  OR comunidad_id IN (
    SELECT comunidad_id FROM perfiles WHERE id = auth.uid() AND rol IN ('admin','tesorero','superadmin')
  )
);

-- 4. FUNCIÓN PARA HASHEAR CLAVES LEGADAS (si aún usas tabla usuarios propia)
-- NOTA: Migra lo antes posible a supabase.auth. Esto es un parche temporal.
CREATE OR REPLACE FUNCTION hash_clave_legado()
RETURNS TRIGGER AS $$
BEGIN
  IF TG_OP = 'INSERT' OR NEW.clave IS DISTINCT FROM OLD.clave THEN
    -- Si la clave ya parece un hash bcrypt (empieza con $2), no tocar
    IF NEW.clave IS NOT NULL AND NEW.clave NOT LIKE '$2%' THEN
      NEW.clave := crypt(NEW.clave, gen_salt('bf', 10));
    END IF;
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Aplicar trigger a tabla usuarios si existe
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name = 'usuarios') THEN
    CREATE TRIGGER trigger_hash_clave
    BEFORE INSERT OR UPDATE ON usuarios
    FOR EACH ROW
    EXECUTE FUNCTION hash_clave_legado();
  END IF;
END $$;

-- 5. FUNCIÓN DE AUDITORÍA AUTOMÁTICA
CREATE OR REPLACE FUNCTION audit_trigger_func()
RETURNS TRIGGER AS $$
DECLARE
  v_old_data JSON;
  v_new_data JSON;
BEGIN
  IF (TG_OP = 'UPDATE') THEN
    v_old_data := row_to_json(OLD);
    v_new_data := row_to_json(NEW);
    INSERT INTO audit_logs (comunidad_id, tabla, accion, registro_id, datos_anteriores, datos_nuevos, usuario_id, created_at)
    VALUES (NEW.comunidad_id, TG_TABLE_NAME, TG_OP, NEW.id, v_old_data, v_new_data, auth.uid(), now());
    RETURN NEW;
  ELSIF (TG_OP = 'DELETE') THEN
    v_old_data := row_to_json(OLD);
    INSERT INTO audit_logs (comunidad_id, tabla, accion, registro_id, datos_anteriores, usuario_id, created_at)
    VALUES (OLD.comunidad_id, TG_TABLE_NAME, TG_OP, OLD.id, v_old_data, auth.uid(), now());
    RETURN OLD;
  ELSIF (TG_OP = 'INSERT') THEN
    v_new_data := row_to_json(NEW);
    INSERT INTO audit_logs (comunidad_id, tabla, accion, registro_id, datos_nuevos, usuario_id, created_at)
    VALUES (NEW.comunidad_id, TG_TABLE_NAME, TG_OP, NEW.id, v_new_data, auth.uid(), now());
    RETURN NEW;
  END IF;
  RETURN NULL;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

