// ════════════════════════════════════════════════════════════════
// /api/send-email.js — Vercel Serverless Function
// ════════════════════════════════════════════════════════════════
//
// SETUP (solo una vez):
//   1. Sube este archivo a /api/send-email.js en GitHub
//   2. En Vercel → Settings → Environment Variables:
//      Nombre: RESEND_KEY
//      Valor:  re_xxxxxxxxxxxxxxxxxxxx  (tu key completa de Resend)
//      Entorno: Production + Preview
//   3. Vercel lo despliega como: https://vecinoo.cl/api/send-email
//
// SEGURIDAD:
//   - La RESEND_KEY NUNCA llega al navegador del usuario
//   - Solo acepta POST
//   - Valida todos los campos antes de llamar a Resend
// ════════════════════════════════════════════════════════════════

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Método no permitido' });
  }

  const origin = req.headers.origin || '';
  const allowed = ['https://vecinoo.cl', 'https://www.vecinoo.cl'];
  if (origin && !allowed.includes(origin) && !origin.includes('localhost') && !origin.includes('vercel.app')) {
    return res.status(403).json({ error: 'Origen no autorizado' });
  }

  const { to, subject, html, from } = req.body || {};

  if (!to || !String(to).includes('@')) {
    return res.status(400).json({ error: 'Campo "to" inválido' });
  }
  if (!subject || !html) {
    return res.status(400).json({ error: 'Faltan campos: subject, html' });
  }
  if (html.length > 50000) {
    return res.status(400).json({ error: 'Email demasiado grande' });
  }

  const RESEND_KEY = process.env.RESEND_KEY;
  if (!RESEND_KEY) {
    console.error('[send-email] RESEND_KEY no configurada en Vercel');
    return res.status(500).json({ error: 'Servicio no configurado' });
  }

  try {
    const r = await fetch('https://api.resend.com/emails', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${RESEND_KEY}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        from: from || 'Vecinoo <noreply@vecinoo.cl>',
        to: Array.isArray(to) ? to : [to],
        subject: String(subject).trim(),
        html,
      }),
    });

    const data = await r.json();

    if (!r.ok) {
      console.error('[send-email] Resend error:', data);
      return res.status(r.status).json({ error: data?.message || 'Error Resend' });
    }

    return res.status(200).json({ ok: true, id: data.id });

  } catch (err) {
    console.error('[send-email] Error:', err.message);
    return res.status(500).json({ error: 'Error interno' });
  }
}
